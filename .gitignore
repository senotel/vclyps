# Local tooling — never belongs in the repo.
# .claude holds Claude Code's tool-permission history. Nothing in the app reads
# it, and dragging the whole project folder into GitHub would otherwise sweep it
# up along with everything else.
.claude/

# Everything the live app does not need: HANDOFF, tests, research, serve.js,
# worker.js (it goes to Cloudflare, never GitHub). The repo is public and is
# the website, so none of it may be pushed.
NO UPLOAD/

# OS clutter that appears on its own
Thumbs.db
desktop.ini
.DS_Store

# Scratch / working files
*.log
*.tmp
node_modules/

# /brag launch-video output: local only
brag-output*/
